<Project Sdk="Microsoft.NET.Sdk">

  <!-- A rendering sample: a rainy cyberpunk street at night, with volumetric fog, to walk round (see the README). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NeonCity</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The engine this sample comes with. Opened in the Vertex editor, it's built against the editor's own instead. -->
    <ProjectReference Include="..\..\Vertex\Vertex.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\**" Exclude="Assets\**\*.cs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

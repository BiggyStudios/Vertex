<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyTitle>vertex</AssemblyTitle>
    <AssemblyName>Vertex</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The doc comments, for code editors and the documentation site's API reference (Tools/DocsData). Not every
         public member has one, so missing ones aren't warned about. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Optimised in Debug builds too: games are usually run in Debug (dotnet run, the editor's Play), and the engine's
         per-frame loops (drawing, physics, navmesh building) run two to three times slower unoptimised. Stepping
         through engine code still works; some of its locals show as optimised away. -->
    <Optimize>true</Optimize>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The engine as a NuGet package, for games made in code without the engine's source (Tools/Release makes it,
         with the release's version). -->
    <PackageId>Vertex.Engine</PackageId>
    <Authors>BiggyStudios</Authors>
    <Description>A 3D game engine in C#, with an editor, C# and visual scripting, Jolt physics, VFX and audio graphs, and multiplayer.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://biggystudios.github.io/Vertex/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/BiggyStudios/Vertex</RepositoryUrl>
    <PackageTags>game engine;3d;games;vulkan;opengl</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- The tests drive the engine without a window, through its internal frame and input methods. -->
    <InternalsVisibleTo Include="Vertex.Tests" />
    <!-- The editor hosts the engine itself (window, input, frames) and edits scenes without running them. -->
    <InternalsVisibleTo Include="Vertex.Editor" />
    <InternalsVisibleTo Include="Vertex.Editor.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Noto Sans, for text that hasn't a font of its own (see Font.Default). -->
    <EmbeddedResource Include="UI\Fonts\*.ttf" LogicalName="Vertex.Fonts.%(Filename)%(Extension)" />
    <None Include="UI\Fonts\OFL.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FontStashSharp.PlatformAgnostic" Version="1.6.2" />
    <PackageReference Include="JoltPhysicsSharp" Version="2.23.0" />
    <PackageReference Include="Silk.NET" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Assimp" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenAL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Shaderc" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Shaderc.Native" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.EXT" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
    <PackageReference Include="StbImageSharp" Version="2.30.16" />
    <PackageReference Include="Steamworks.NET.AnyCPU" Version="2026.165.3" />
  </ItemGroup>

  <!-- The packages the engine uses, written into it ("Vertex.Package.Silk.NET.Windowing" = "2.23.0"), so the editor can
       build a game for any system with the same ones, and their native libraries for that system. -->
  <Target Name="VertexRecordPackages" BeforeTargets="GetAssemblyAttributes">
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'@(PackageReference)' != ''">
        <_Parameter1>Vertex.Package.%(PackageReference.Identity)</_Parameter1>
        <_Parameter2>%(PackageReference.Version)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

</Project>
